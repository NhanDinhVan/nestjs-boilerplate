NODE_ENV=local
PORT=3000

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=my_database
# Set DB_SSL=true for staging/uat/release. For release, rejectUnauthorized=true is enforced automatically.
DB_SSL=false

# Connection pool (tune against your DB server's max_connections)
DB_POOL_SIZE=10
# Release idle connections after 30s to avoid saturating pg max_connections
DB_IDLE_TIMEOUT_MS=30000
# Fail fast if the DB is unreachable — surfaces issues early in health checks
DB_CONNECTION_TIMEOUT_MS=5000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
