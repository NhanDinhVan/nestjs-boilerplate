{
    "useTabs": false,
    "tabWidth": 4,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "always",
    "printWidth": 100,
    "endOfLine": "auto",
    "plugins": ["@ianvs/prettier-plugin-sort-imports"],
    "importOrder": ["^(react|next)", "^@?\\w", "^[./]"],
    "importOrderParserPlugins": ["typescript", "decorators"]
}
