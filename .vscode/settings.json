{
  "cSpell.words": [],
  
  // ============================================
  // General Editor Settings
  // ============================================
  "editor.tabSize": 4,
  "editor.indentSize": 4,
  "editor.insertSpaces": true,

  // ============================================
  // Import & Module Settings
  // ============================================
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.importModuleSpecifierEnding": "auto",

  // ============================================
  // TypeScript Configuration
  // ============================================
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false,
    "editor.tabSize": 4,
    "editor.indentSize": 4
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false,
    "editor.tabSize": 4,
    "editor.indentSize": 4
  },

  // ============================================
  // JavaScript Configuration
  // ============================================
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false,
    "editor.tabSize": 4,
    "editor.indentSize": 4
  },

  // ============================================
  // JSON Configuration (2 spaces standard)
  // ============================================
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false,
    "editor.tabSize": 2,
    "editor.indentSize": 2
  },

  // ============================================
  // ESLint Settings
  // ============================================
  "eslint.enable": true,
  "eslint.validate": ["typescript", "typescriptreact", "javascript"],
  "eslint.format.enable": false,

  // ============================================
  // Formatting Options
  // ============================================
  "editor.formatOnPaste": false,

  // ============================================
  // Prettier Extension Settings
  // ============================================
  "prettier.enable": true,
  "prettier.documentRangeFormattingProvider.enable": true
}

